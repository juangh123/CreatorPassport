# Next.js App URL (for OAuth redirects and API routes)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Configuration
# You can find these in your Supabase project under Settings > API
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Minds by Animoca Brands Builder API
# Create this in the Builder console, not in the consumer Minds account.
MINDS_BUILDER_API_KEY=your-minds-builder-api-key

# Required for generation unless you bind a per-creator agent ID in the dashboard.
# If no agent is configured, generation returns a clear configuration error.
MINDS_AGENT_ID=your-minds-agent-id
